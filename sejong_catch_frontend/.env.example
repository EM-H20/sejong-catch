# ===================================
# 세종 캐치 환경 변수 설정 (샘플)
# ===================================
# 이 파일을 .env로 복사하여 사용하세요
# cp .env.example .env

# Mock 모드 사용 여부
# - true: Mock 데이터 사용 (개발/테스트)
# - false: 실제 API 호출 (프로덕션)
USE_MOCK_AUTH=true

# 백엔드 서버 URL
NODE_BACKEND_URL=http://152.67.219.91:8888
LOCAL_BACKEND_URL=http://127.0.0.1:8081
